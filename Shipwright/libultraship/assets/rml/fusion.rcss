body {
    width: 100%; height: 100%; margin: 0;
    background-color: #111b2d;
    font-family: LatoLatin; font-size: 3.6vh; color: #edf4ff;
}
#window {
    position: absolute; left: 5%; top: 6%; width: 90%; height: 88%;
    overflow-y: auto;
}
h1 { margin: 0 0 5vh; font-size: 6vh; }
h2 { margin: 0 0 4vh; font-size: 4.6vh; }
.games { display: flex; width: 100%; }
.game { width: 44%; margin-right: 2%; padding: 2%; background-color: #1c2d46; }
.game h2 { min-height: 12vh; }
h2[selected] { color: #9edbff; }
button, select-button {
    display: block; padding: 2vh 2vw; margin: 1vh 0;
    background-color: #2c4261; border: 2px #2c4261;
    color: #edf4ff; font-family: LatoLatin; font-size: 3.6vh;
    tab-index: auto;
}
button:focus, button:hover, select-button:focus, select-button:hover {
    background-color: #2777aa; border-color: #b7e8ff;
}
.utilities { display: flex; margin-top: 4vh; }
.utilities button { width: 38%; margin-right: 3%; }
.hint { color: #bccbdc; font-size: 2.9vh; margin-top: 4vh; }
tab-bar { display: flex; margin-bottom: 4vh; }
tab { display: block; padding: 2vh 3vw; background-color: #1c2d46; }
tab.selected { background-color: #2777aa; }
content { display: block; }
pane { display: none; }
pane.active { display: block; }
select-button { display: flex; }
key { width: 70%; }
value { width: 30%; text-align: right; }
