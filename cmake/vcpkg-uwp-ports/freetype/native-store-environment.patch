--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -364,6 +364,15 @@
 # Create the options file.
 file(READ "${PROJECT_SOURCE_DIR}/include/freetype/config/ftoption.h"
   FTOPTION_H)
+if (CMAKE_SYSTEM_NAME STREQUAL "WindowsStore")
+  # FT_Init_FreeType calls FT_Set_Default_Properties.  Its optional process
+  # environment override imports getenv, which is not supported in UWP.
+  # Select the upstream no-op implementation; FT_Property_Set remains usable.
+  string(REPLACE
+    "#define FT_CONFIG_OPTION_ENVIRONMENT_PROPERTIES"
+    "/* #undef FT_CONFIG_OPTION_ENVIRONMENT_PROPERTIES */"
+    FTOPTION_H "${FTOPTION_H}")
+endif ()
 if (ZLIB_FOUND)
   string(REGEX REPLACE
     "/\\* +(#define +FT_CONFIG_OPTION_SYSTEM_ZLIB) +\\*/" "\\1"
